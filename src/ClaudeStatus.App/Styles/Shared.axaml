<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:ClaudeStatus.App.Controls">

    <!--
        The app's design system. Two rules hold everything together:

        1. Every colour is a DynamicResource written by ThemeApplier, never a
           literal. A StaticResource would resolve once and the theme picker would
           appear to do nothing until the window was reopened.
        2. Sizes come from the scale below rather than from whatever looked right
           in the view being edited at the time. Seven type sizes and two radii are
           what keeps four windows written weeks apart looking like one app.
    -->

    <Styles.Resources>
        <!--
            The type scale: 9 / 10 / 11 / 12 / 13 / 15 / 26. The jump from 15 to 26 is
            deliberate - a usage percentage is the one thing this app exists to
            show, so it gets a size nothing else is allowed to use.

            The bottom two are the taskbar's alone. Unit is for a mark that is not
            read at all, only recognised - the per-cent sign, which the eye skips
            on its way to the number in front of it. Micro is for something still
            read but never first: the widget's countdown. Nothing that carries
            meaning on its own may use either.
        -->
        <x:Double x:Key="Size.Unit">9</x:Double>
        <x:Double x:Key="Size.Micro">10</x:Double>
        <x:Double x:Key="Size.Caption">11</x:Double>
        <x:Double x:Key="Size.Body">12</x:Double>
        <x:Double x:Key="Size.Strong">13</x:Double>
        <x:Double x:Key="Size.Heading">15</x:Double>
        <x:Double x:Key="Size.Display">26</x:Double>

        <!-- Two radii: one for panels, one for the controls inside them. -->
        <CornerRadius x:Key="Radius.Panel">10</CornerRadius>
        <CornerRadius x:Key="Radius.Control">6</CornerRadius>

        <Thickness x:Key="Pad.Panel">18</Thickness>
        <Thickness x:Key="Pad.Card">12,10</Thickness>
    </Styles.Resources>

    <!-- ==============================================================
         Typography
         ============================================================== -->

    <!--
        A section title. Text colour, not the accent: with several of these
        stacked, accent-coloured headings compete with the numbers they are
        supposed to be introducing.
    -->
    <Style Selector="TextBlock.heading">
        <Setter Property="FontSize" Value="{StaticResource Size.Heading}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.Text}" />
    </Style>

    <!--
        A field label above the thing it names. Small, muted and letterspaced -
        the letterspacing is what stops 11px capitals reading as a cramped block,
        and it is most of why these look considered rather than merely small.
    -->
    <Style Selector="TextBlock.label">
        <Setter Property="FontSize" Value="{StaticResource Size.Caption}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LetterSpacing" Value="0.9" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.Muted}" />
    </Style>

    <!--
        The muted grey is derived from the theme's text colour, not declared, so it
        tints with the palette and cannot be picked against the wrong background.
        Opacity stays at 1 because the colour already carries the fade - stacking
        the two would wash it out on a translucent OSD.
    -->
    <Style Selector="TextBlock.caption">
        <Setter Property="FontSize" Value="{StaticResource Size.Caption}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.Muted}" />
    </Style>

    <!--
        The sentence under a checkbox or a radio button. It hangs off the option's
        own text, not off its box: the 28 px is the Fluent template's 20 px box
        plus the 8 px content padding, so the help starts on the same vertical as
        the word it explains and the boxes stay the only things breaking that edge.
        Applied on top of .caption, so it only adds the indent.

        The negative top pulls it back up: most of the gap under an option is the
        two line boxes meeting - the option's descent under its baseline, then the
        help's own leading over its capitals - and neither is space anybody asked
        for. This takes about half of it back, which is as close as the pair can
        sit before the sentence starts to read as a second line of the label.
    -->
    <Style Selector="TextBlock.caption.option-help">
        <Setter Property="Margin" Value="28,-3,0,0" />
    </Style>

    <Style Selector="TextBlock.metric">
        <Setter Property="FontSize" Value="{StaticResource Size.Strong}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.Text}" />
    </Style>

    <Style Selector="TextBlock.metric.exceeded">
        <Setter Property="Foreground" Value="{DynamicResource Theme.Alert}" />
    </Style>

    <Style Selector="TextBlock.metric.unknown">
        <Setter Property="Foreground" Value="{DynamicResource Theme.Muted}" />
    </Style>

    <!--
        The headline percentage.

        "+tnum" asks the font for tabular figures - every digit the same width.
        Without it a number ticking from 68 % to 71 % visibly shifts, because in
        most proportional fonts a 1 is narrower than an 8, and a number that
        twitches every minute looks broken however correct it is. Fonts without
        the feature ignore it.
    -->
    <Style Selector="TextBlock.display">
        <Setter Property="FontSize" Value="{StaticResource Size.Display}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontFeatures" Value="+tnum" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.Text}" />
        <Setter Property="LineHeight" Value="30" />
    </Style>

    <!-- The metric whose bar has crossed the threshold. -->
    <Style Selector="TextBlock.display.exceeded">
        <Setter Property="Foreground" Value="{DynamicResource Theme.Alert}" />
    </Style>

    <!-- No reading at all. A dash, deliberately quiet - it is not a number. -->
    <Style Selector="TextBlock.display.unknown">
        <Setter Property="Foreground" Value="{DynamicResource Theme.Muted}" />
    </Style>

    <!--
        The source's own severity label when it is not "normal". Applied on top of
        .caption, so it keeps the small size and only changes the colour and weight.
    -->
    <Style Selector="TextBlock.caption.exceeded">
        <Setter Property="Foreground" Value="{DynamicResource Theme.Alert}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- ==============================================================
         Surfaces
         ============================================================== -->

    <!-- A warning panel. Used for the weak-store and stale notices. -->
    <Style Selector="Border.warning">
        <Setter Property="Background" Value="{DynamicResource Theme.AlertSurface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.AlertBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}" />
        <Setter Property="Padding" Value="{StaticResource Pad.Card}" />
    </Style>

    <Style Selector="Border.notice">
        <Setter Property="Background" Value="{DynamicResource Theme.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}" />
        <Setter Property="Padding" Value="{StaticResource Pad.Card}" />
    </Style>

    <!--
        A card in the report window. No outline - the surface tint alone separates
        it from the page, and a dozen bordered boxes stacked vertically turn a
        report into a spreadsheet.
    -->
    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource Theme.Surface}" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}" />
        <Setter Property="Padding" Value="{StaticResource Pad.Card}" />
    </Style>

    <!-- A hairline rule. A Border rather than a Separator: exactly one pixel. -->
    <Style Selector="Border.rule">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{DynamicResource Theme.Border}" />
    </Style>

    <!-- ==============================================================
         Usage bars
         ============================================================== -->

    <Style Selector="controls|UsageBar">
        <Setter Property="Height" Value="6" />
        <Setter Property="Track" Value="{DynamicResource Theme.Track}" />
        <Setter Property="Fill" Value="{DynamicResource Theme.Primary}" />
    </Style>

    <Style Selector="controls|UsageBar.exceeded">
        <Setter Property="Fill" Value="{DynamicResource Theme.Alert}" />
    </Style>

    <!-- Nothing to draw. The empty track still shows where a reading would go. -->
    <Style Selector="controls|UsageBar.unknown">
        <Setter Property="Fill" Value="{x:Null}" />
    </Style>

    <!-- ==============================================================
         Controls
         ============================================================== -->

    <!--
        Colours come from the Button* brushes ThemeApplier overrides, because a
        Background set here would be painted over by Fluent's template. What is
        left - the shape, the padding, the transition - is what a Style can still
        reach.
    -->
    <Style Selector="Button">
        <Setter Property="FontSize" Value="{StaticResource Size.Body}" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}" />
        <Setter Property="Padding" Value="14,7" />
    </Style>

    <!--
        The primary action. Filled with the accent and labelled in OnPrimary - the
        black-or-white that accent can actually carry.

        Set on the ContentPresenter because that is the element Fluent's template
        paints; a Background on the Button itself is silently discarded.
    -->
    <Style Selector="Button.accent /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Theme.Primary}" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.OnPrimary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Primary}" />
    </Style>

    <Style Selector="Button.accent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SystemAccentColorLight1}" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.OnPrimary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColorLight1}" />
    </Style>

    <Style Selector="Button.accent:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SystemAccentColorDark1}" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.OnPrimary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColorDark1}" />
    </Style>

    <!--
        A secondary action that should not look like one. No fill and no outline
        until the pointer arrives, so it can sit in a footer without competing.
    -->
    <Style Selector="Button.ghost /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.Muted}" />
    </Style>

    <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Theme.Surface}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.Text}" />
    </Style>

    <!--
        Fluent sizes tab headers for a phone-style pivot - 24px, taller than the
        window title. In a 480px settings dialog that makes the tab strip the
        loudest thing on screen and the settings themselves look like a footnote.
    -->
    <Style Selector="TabItem">
        <Setter Property="FontSize" Value="{StaticResource Size.Strong}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="2,8,2,4" />
        <Setter Property="Margin" Value="0,0,20,0" />
    </Style>

    <!--
        Air between the label and the selection underline. Fluent's template puts
        the pipe at the bottom of the same panel as the header text, so the two
        touch; TabItem.Padding cannot separate them because it wraps both. A
        bottom margin on the header alone grows the panel under the text and the
        pipe follows the panel's edge down. The 4 px taken off Padding above keeps
        the tab strip the same height it was.
    -->
    <Style Selector="TabItem /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <!-- ==============================================================
         Window defaults
         ============================================================== -->

    <!--
        Plain text and the window surface. Set at the window level rather than on
        every control, so a theme change repaints everything including controls
        this file never names.
    -->
    <Style Selector="Window">
        <Setter Property="Background" Value="{DynamicResource Theme.Background}" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.Text}" />
        <Setter Property="FontFamily" Value="{DynamicResource Theme.FontFamily}" />
    </Style>

    <Style Selector="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Size.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.Text}" />
    </Style>

    <!--
        Tooltips carry the theme too. Fluent's default is a grey box that matches
        neither the popup nor the widget it hangs off; this makes it the same
        surface as the details popup, so hovering and clicking look related.
    -->
    <!--
        The widget's hover card: the same surface as the details popup, so the
        two read as one thing. A Border because the card is a window of our own,
        not a ToolTip - see TaskbarHoverWindow.
    -->
    <Style Selector="Border.hoverCard">
        <Setter Property="Background" Value="{DynamicResource Theme.OsdBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.OsdBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}" />
        <Setter Property="Padding" Value="14,12" />
    </Style>

    <Style Selector="ToolTip">
        <Setter Property="Background" Value="{DynamicResource Theme.OsdBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.OsdBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}" />
        <Setter Property="Padding" Value="14,12" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.Text}" />
    </Style>

    <Style Selector="Separator">
        <Setter Property="Background" Value="{DynamicResource Theme.Border}" />
    </Style>

    <!-- ==============================================================
         Taskbar widget (TaskbarWidgetWindow)
         ============================================================== -->

    <!--
        The card. The theme's OSD surface rather than the taskbar's own colour,
        which is not ours to know: text is only ever drawn on a surface the theme
        catalogue has already checked it against. It also means the popup's
        transparency setting applies here too, so the two look like one thing.

        The outline is the theme's primary rather than the OSD border the popup
        uses. The popup opens over the desktop, where a hairline is enough to say
        where it ends; this card sits inside the taskbar, against chrome we do not
        control and did not choose, and a faint border there reads as an edge of
        the taskbar rather than as the edge of this app. The accent is the one
        colour on the strip that is unambiguously ours.
    -->
    <Style Selector="Border.widget">
        <Setter Property="Background" Value="{DynamicResource Theme.OsdBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Primary}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}" />
        <Setter Property="Padding" Value="14,4" />
        <Setter Property="Margin" Value="0,5" />
    </Style>

    <!--
        The app mark that leads the card. Primary here, because on the
        themed card the mark is the one place the accent appears - the
        numbers are text and the bars carry their own meaning - so it is what
        ties the strip to whichever theme is chosen.

        The outline is AppMark.Geometry, the same one the details and info
        headings draw, so the three cannot drift apart. Only the box and the ink
        are set here; sizing lives in a style rather than on the Path because the
        blended and themed variants differ by ink alone.
    -->
    <Style Selector="Path.widgetMark">
        <Setter Property="Fill" Value="{DynamicResource Theme.Primary}" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="Width" Value="19" />
        <Setter Property="Height" Value="19" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!--
        Every metric the same width, including the ones with nothing extra to put
        in it. The session column has to hold "5h (2:37) 29%" and the others only
        "7d 58%", but sizing each to its own content would give the two bars
        different lengths, and two bars of different lengths cannot be compared at
        a glance - which is the only thing they are there for.
    -->
    <Style Selector="StackPanel.widgetMetric">
        <Setter Property="Width" Value="82" />
    </Style>

    <!-- A stale reading fades exactly as the tray icon does, so the two agree. -->
    <Style Selector="StackPanel.stale">
        <Setter Property="Opacity" Value="0.55" />
    </Style>

    <Style Selector="TextBlock.widgetLabel">
        <Setter Property="FontSize" Value="{StaticResource Size.Caption}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.Muted}" />
    </Style>

    <!-- Tabular figures for the same reason as .display: a number that twitches looks broken. -->
    <Style Selector="TextBlock.widgetValue">
        <Setter Property="FontSize" Value="{StaticResource Size.Body}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontFeatures" Value="+tnum" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.Text}" />
    </Style>

    <Style Selector="TextBlock.widgetValue.exceeded">
        <Setter Property="Foreground" Value="{DynamicResource Theme.Alert}" />
    </Style>

    <Style Selector="TextBlock.widgetValue.unknown">
        <Setter Property="Foreground" Value="{DynamicResource Theme.Muted}" />
    </Style>

    <!--
        The per-cent sign after the number. A step down the type scale: it is a
        unit, not a word, and the number is what the eye is looking for. Declared
        after .widgetValue because it shares that class - equal specificity, so the
        later font size is the one that wins.

        The margin is a pixel of air before it and a pixel of lift off the
        baseline. Bottom-aligned, 9 px sits level with the digits' feet and reads
        as if it had fallen off them; raised one pixel it sits where a superscript
        unit belongs. Both are single pixels because the whole mark is nine.
    -->
    <Style Selector="TextBlock.widgetValue.widgetSign">
        <Setter Property="FontSize" Value="{StaticResource Size.Unit}" />
        <Setter Property="Margin" Value="1,0,0,1" />
    </Style>

    <!--
        The countdown beside the "5h" label: how long is left of that window, as a
        bare clock. Muted and micro on purpose - it is the answer to "and how long
        have I got", asked after the percentage, never before it.
    -->
    <Style Selector="TextBlock.widgetClock">
        <Setter Property="FontSize" Value="{StaticResource Size.Micro}" />
        <Setter Property="FontFeatures" Value="+tnum" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.Muted}" />
    </Style>

    <!-- The "!", "⊘" or "—" when there is nothing to show. -->
    <Style Selector="TextBlock.widgetGlyph">
        <Setter Property="FontSize" Value="{StaticResource Size.Heading}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.Alert}" />
    </Style>

    <Style Selector="controls|UsageBar.widgetBar">
        <Setter Property="Height" Value="3" />
    </Style>

    <!--
        The time bar, drawn flush under the usage bar: how much of the window has
        elapsed, against how much of it has been spent.

        It carries the same groove as the bar above it, so the pair reads as two
        measurements of one window rather than as a bar with a smear under it: the
        track is what says where 100 % is, and without it the elapsed share had no
        end to be a share of. One pixel of air keeps the two from fusing into a
        single fat bar; the fill is muted because this one is context, and the
        question it answers is only whether the bar above is ahead of the clock.
    -->
    <Style Selector="controls|UsageBar.widgetTimeBar">
        <Setter Property="Height" Value="3" />
        <Setter Property="Margin" Value="0,1,0,0" />
        <Setter Property="Track" Value="{DynamicResource Theme.Track}" />
        <Setter Property="Fill" Value="{DynamicResource Theme.Muted}" />
    </Style>

    <!--
        The blended variant. No card, and every colour comes from the Widget.*
        resources TaskbarInk writes from the taskbar's own light/dark appearance -
        the clock's colour, in effect. Only the alert red stays the theme's: it is
        a signal, and a signal that changed colour with the taskbar would be one
        less thing the user could learn to recognise.

        The descendant selectors are more specific than the plain ones above, so
        .exceeded and .unknown have to be restated here or the ink would win.

        Padding is restated for the same reason, and it is the setter most likely
        to be deleted as redundant: it is not. The card above carries 14,4 to give
        its primary outline something to enclose, and blended there is no outline,
        so the widget would simply sit further from the tray for no reason anyone
        looking at it could see. This keeps the blended strip where it has always
        been - the card grew, and blending did not.
    -->
    <Style Selector="Border.widget.system">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="10,0" />
    </Style>

    <!--
        Blended, the mark drops the accent and takes the taskbar ink, the same
        colour as the clock and as the values beside it. A themed primary here
        would be the one coloured thing on a strip that is meant to read as
        part of the taskbar, and on a taskbar tinted near that primary it
        would be the one thing that disappeared.
    -->
    <Style Selector="Border.widget.system Path.widgetMark">
        <Setter Property="Fill" Value="{DynamicResource Widget.Ink}" />
    </Style>

    <Style Selector="Border.widget.system TextBlock.widgetLabel">
        <Setter Property="Foreground" Value="{DynamicResource Widget.InkMuted}" />
    </Style>

    <Style Selector="Border.widget.system TextBlock.widgetClock">
        <Setter Property="Foreground" Value="{DynamicResource Widget.InkMuted}" />
    </Style>

    <Style Selector="Border.widget.system TextBlock.widgetValue">
        <Setter Property="Foreground" Value="{DynamicResource Widget.Ink}" />
    </Style>

    <Style Selector="Border.widget.system TextBlock.widgetValue.exceeded">
        <Setter Property="Foreground" Value="{DynamicResource Theme.Alert}" />
    </Style>

    <Style Selector="Border.widget.system TextBlock.widgetValue.unknown">
        <Setter Property="Foreground" Value="{DynamicResource Widget.InkMuted}" />
    </Style>

    <Style Selector="Border.widget.system controls|UsageBar.widgetBar">
        <Setter Property="Track" Value="{DynamicResource Widget.Track}" />
    </Style>

    <!--
        Blended, the time bar takes the taskbar's own muted ink - the same
        relationship to the value above it as the "5h" label has to the number.
    -->
    <Style Selector="Border.widget.system controls|UsageBar.widgetTimeBar">
        <Setter Property="Track" Value="{DynamicResource Widget.Track}" />
        <Setter Property="Fill" Value="{DynamicResource Widget.InkMuted}" />
    </Style>

</Styles>

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ClaudeStatus.App.ViewModels"
        xmlns:controls="using:ClaudeStatus.App.Controls"
        x:Class="ClaudeStatus.App.Views.TaskbarWidgetWindow"
        x:DataType="vm:TaskbarWidgetViewModel"
        Title="ClaudeStatus"
        SizeToContent="Width"
        Height="48"
        CanResize="False"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        WindowDecorations="None"
        WindowStartupLocation="Manual"
        Background="Transparent"
        TransparencyLevelHint="Transparent">

    <!--
        This window is re-parented into the operating system's taskbar by
        TaskbarWidgetIndicator, so almost every property above is about making it
        behave like a piece of the taskbar rather than a window: no chrome, no
        taskbar button of its own, never activated, transparent around the card.

        The card is what carries the colour. It uses the theme's own OSD surface,
        which is the trick that sidesteps the tray icon's whole contrast problem:
        the widget never draws text directly on the taskbar, only on a surface
        whose text colour the theme catalogue has already checked against it.

        Windows only in practice. TrayApplicationController builds this indicator
        only when ITaskbarHost.IsSupported, and the only host that returns true is
        WindowsTaskbarHost; macOS and Linux get UnsupportedTaskbarHost and keep the
        tray icon. Nothing in this file needs an OS check of its own.
    -->

    <Window.Resources>
        <!--
            The Claude mark, the path out of Assets/claude-mark.svg. It is inlined
            as geometry rather than shown as an image because it has to change
            colour: the asset carries a black fill, and here the mark is drawn in
            either the theme's primary or the taskbar's own ink, exactly like the
            text beside it. Stretch="Uniform" in the style is what makes the
            source's 96-unit viewBox and its offset group irrelevant.
        -->
        <StreamGeometry x:Key="ClaudeMark">M4.709 15.955l4.72-2.647.08-.23-.08-.128H9.2l-.79-.048-2.698-.073-2.339-.097-2.266-.122-.571-.121L0 11.784l.055-.352.48-.321.686.06 1.52.103 2.278.158 1.652.097 2.449.255h.389l.055-.157-.134-.098-.103-.097-2.358-1.596-2.552-1.688-1.336-.972-.724-.491-.364-.462-.158-1.008.656-.722.881.06.225.061.893.686 1.908 1.476 2.491 1.833.365.304.145-.103.019-.073-.164-.274-1.355-2.446-1.446-2.49-.644-1.032-.17-.619a2.97 2.97 0 0 1 -.104 -.729L6.283.134 6.696 0l.996.134.42.364.62 1.414 1.002 2.229 1.555 3.03.456.898.243.832.091.255h.158V9.01l.128-1.706.237-2.095.23-2.695.08-.76.376-.91.747-.492.584.28.48.685-.067.444-.286 1.851-.559 2.903-.364 1.942h.212l.243-.242.985-1.306 1.652-2.064.73-.82.85-.904.547-.431h1.033l.76 1.129-.34 1.166-1.064 1.347-.881 1.142-1.264 1.7-.79 1.36.073.11.188-.02 2.856-.606 1.543-.28 1.841-.315.833.388.091.395-.328.807-1.969.486-2.309.462-3.439.813-.042.03.049.061 1.549.146.662.036h1.622l3.02.225.79.522.474.638-.079.485-1.215.62-1.64-.389-3.829-.91-1.312-.329h-.182v.11l1.093 1.068 2.006 1.81 2.509 2.33.127.578-.322.455-.34-.049-2.205-1.657-.851-.747-1.926-1.62h-.128v.17l.444.649 2.345 3.521.122 1.08-.17.353-.608.213-.668-.122-1.374-1.925-1.415-2.167-1.143-1.943-.14.08-.674 7.254-.316.37-.729.28-.607-.461-.322-.747.322-1.476.389-1.924.315-1.53.286-1.9.17-.632-.012-.042-.14.018-1.434 1.967-2.18 2.945-1.726 1.845-.414.164-.717-.37.067-.662.401-.589 2.388-3.036 1.44-1.882.93-1.086-.006-.158h-.055L4.132 18.56l-1.13.146-.487-.456.061-.746.231-.243 1.908-1.312-.006.006z</StreamGeometry>

        <!-- One template for all three metrics, so they cannot drift apart. -->
        <DataTemplate x:Key="WidgetMetricTemplate" DataType="vm:UsageBarViewModel">
            <StackPanel Classes="widgetMetric" Spacing="4" VerticalAlignment="Center">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                    <TextBlock Grid.Column="0"
                               Classes="widgetLabel"
                               VerticalAlignment="Center"
                               Text="{Binding Label}" />
                    <TextBlock Grid.Column="1"
                               Classes="widgetValue"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Classes.exceeded="{Binding IsExceeded}"
                               Classes.unknown="{Binding !IsKnown}"
                               Text="{Binding PercentText}" />
                </Grid>
                <controls:UsageBar Classes="widgetBar"
                                   Percent="{Binding Percent}"
                                   Classes.exceeded="{Binding IsExceeded}"
                                   Classes.unknown="{Binding !IsKnown}" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <!--
        .system drops the card: transparent, borderless, and every colour inside
        it switches to the Widget.* resources TaskbarInk writes from the taskbar's
        own appearance. The class is set here, on the root, and the styles reach
        the metric templates through descendant selectors - their DataContext is
        a UsageBarViewModel, which knows nothing about this choice.
    -->
    <Border Name="Card"
            Classes="widget"
            Classes.system="{Binding FollowsSystem}"
            HorizontalAlignment="Left"
            VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <!--
                The mark leads, before the 5h metric. It sits outside the Panel
                below rather than inside the metric row so it also stands in the
                no-reading states: it says which app this strip of taskbar belongs
                to, and an identity that vanishes the moment a poll fails is not
                doing that job. For the same reason it does not take the .stale
                fade - it is not a reading.
            -->
            <Path Classes="widgetMark" Data="{StaticResource ClaudeMark}" />

            <Panel>
                <StackPanel Orientation="Horizontal"
                            Spacing="14"
                            VerticalAlignment="Center"
                            IsVisible="{Binding HasReading}"
                            Classes.stale="{Binding IsStale}">
                    <ContentControl Content="{Binding Session}"
                                    ContentTemplate="{StaticResource WidgetMetricTemplate}" />
                    <ContentControl Content="{Binding Week}"
                                    ContentTemplate="{StaticResource WidgetMetricTemplate}" />
                    <ContentControl Content="{Binding WeekFable}"
                                    IsVisible="{Binding ShowFable}"
                                    ContentTemplate="{StaticResource WidgetMetricTemplate}" />
                </StackPanel>

                <!--
                    Nothing to show: the same three states the tray icon draws as
                    shapes, with a word beside each because here there is room for one.
                -->
                <StackPanel Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center"
                            IsVisible="{Binding !HasReading}">
                    <TextBlock Classes="widgetGlyph"
                               VerticalAlignment="Center"
                               Text="{Binding AlertGlyph}" />
                    <TextBlock Classes="widgetValue"
                               VerticalAlignment="Center"
                               Text="{Binding AlertText}" />
                </StackPanel>
            </Panel>
        </StackPanel>
    </Border>
</Window>

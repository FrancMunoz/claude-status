<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ClaudeStatus.App.ViewModels"
        xmlns:controls="using:ClaudeStatus.App.Controls"
        xmlns:branding="using:ClaudeStatus.App.Branding"
        x:Class="ClaudeStatus.App.Views.TaskbarWidgetWindow"
        x:DataType="vm:TaskbarWidgetViewModel"
        Title="ClaudeStatus"
        SizeToContent="Width"
        Height="48"
        CanResize="False"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        WindowDecorations="None"
        WindowStartupLocation="Manual"
        Background="Transparent"
        TransparencyLevelHint="Transparent">

    <!--
        This window is re-parented into the operating system's taskbar by
        TaskbarWidgetIndicator, so almost every property above is about making it
        behave like a piece of the taskbar rather than a window: no chrome, no
        taskbar button of its own, never activated, transparent around the card.

        The card is what carries the colour. It uses the theme's own OSD surface,
        which is the trick that sidesteps the tray icon's whole contrast problem:
        the widget never draws text directly on the taskbar, only on a surface
        whose text colour the theme catalogue has already checked against it.

        Windows only in practice. TrayApplicationController builds this indicator
        only when ITaskbarHost.IsSupported, and the only host that returns true is
        WindowsTaskbarHost; macOS and Linux get UnsupportedTaskbarHost and keep the
        tray icon. Nothing in this file needs an OS check of its own.
    -->

    <Window.Resources>
        <!-- One template for all three metrics, so they cannot drift apart. -->
        <DataTemplate x:Key="WidgetMetricTemplate" DataType="vm:UsageBarViewModel">
            <!--
                Spacing is 0 and the two bars touch on purpose. The usage bar and
                the time bar under it are one reading of two quantities - percent
                spent against percent of the window elapsed - and a gap between
                them would invite reading them as two unrelated things. Space here
                is also the scarcest thing the widget has: the taskbar's height is
                fixed and every pixel of padding is one the bars cannot use.
            -->
            <StackPanel Classes="widgetMetric" Spacing="0" VerticalAlignment="Center">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                    <!--
                        The label, and after it the countdown for windows short
                        enough to have one - only the 5h in practice. It is bound
                        on every metric rather than only the session because the
                        view model decides which windows get a clock, not the view;
                        the weekly bars simply hide it.
                    -->
                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                Spacing="4"
                                VerticalAlignment="Center">
                        <TextBlock Classes="widgetLabel"
                                   VerticalAlignment="Bottom"
                                   Text="{Binding Label}" />
                        <TextBlock Classes="widgetClock"
                                   VerticalAlignment="Bottom"
                                   IsVisible="{Binding HasClock}"
                                   Text="{Binding ClockText}" />
                    </StackPanel>
                    <!--
                        Number and sign as two blocks, not one string: the sign is
                        set smaller and hard against the digits, which is worth a
                        few pixels of a strip this size and is the shape people
                        already read on a phone's battery. Both halves come from
                        the view model, so a language can still say what its sign
                        is - see UsageBarViewModel.PercentNumberText. The sign goes
                        with the number when there is no reading: a lone "%" after
                        a dash reads as a broken string.
                    -->
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <TextBlock Classes="widgetValue"
                                   VerticalAlignment="Bottom"
                                   Classes.exceeded="{Binding IsExceeded}"
                                   Classes.unknown="{Binding !IsKnown}"
                                   Text="{Binding PercentNumberText}" />
                        <TextBlock Classes="widgetValue widgetSign"
                                   VerticalAlignment="Bottom"
                                   IsVisible="{Binding IsKnown}"
                                   Classes.exceeded="{Binding IsExceeded}"
                                   Text="{Binding PercentSign}" />
                    </StackPanel>
                </Grid>
                <controls:UsageBar Classes="widgetBar"
                                   Percent="{Binding Percent}"
                                   Classes.exceeded="{Binding IsExceeded}"
                                   Classes.unknown="{Binding !IsKnown}" />

                <!--
                    The clock, under the spend. It keeps its height when there is
                    no reset time to draw it from (IsVisible would make the row
                    above jump as windows come and go); with nothing to show it
                    draws nothing, because it has no track and a zero percent
                    fills none of it. It never takes the exceeded red either: a
                    window 100 % through its time has simply reset, which is good
                    news, and colouring it like an exhausted budget says the
                    opposite.
                -->
                <controls:UsageBar Classes="widgetTimeBar" Percent="{Binding TimePercent}" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <!--
        .system drops the card: transparent, borderless, and every colour inside
        it switches to the Widget.* resources TaskbarInk writes from the taskbar's
        own appearance. The class is set here, on the root, and the styles reach
        the metric templates through descendant selectors - their DataContext is
        a UsageBarViewModel, which knows nothing about this choice.
    -->
    <Border Name="Card"
            Classes="widget"
            Classes.system="{Binding FollowsSystem}"
            HorizontalAlignment="Left"
            VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <!--
                The mark leads, before the 5h metric. It sits outside the Panel
                below rather than inside the metric row so it also stands in the
                no-reading states: it says which app this strip of taskbar belongs
                to, and an identity that vanishes the moment a poll fails is not
                doing that job. For the same reason it does not take the .stale
                fade - it is not a reading.
            -->
            <Path Classes="widgetMark" Data="{x:Static branding:AppMark.Geometry}" />

            <Panel>
                <StackPanel Orientation="Horizontal"
                            Spacing="14"
                            VerticalAlignment="Center"
                            IsVisible="{Binding HasReading}"
                            Classes.stale="{Binding IsStale}">
                    <ContentControl Content="{Binding Session}"
                                    ContentTemplate="{StaticResource WidgetMetricTemplate}" />
                    <ContentControl Content="{Binding Week}"
                                    ContentTemplate="{StaticResource WidgetMetricTemplate}" />
                    <ContentControl Content="{Binding WeekFable}"
                                    IsVisible="{Binding ShowFable}"
                                    ContentTemplate="{StaticResource WidgetMetricTemplate}" />
                </StackPanel>

                <!--
                    Nothing to show: the same three states the tray icon draws as
                    shapes, with a word beside each because here there is room for one.
                -->
                <StackPanel Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center"
                            IsVisible="{Binding !HasReading}">
                    <TextBlock Classes="widgetGlyph"
                               VerticalAlignment="Center"
                               Text="{Binding AlertGlyph}" />
                    <TextBlock Classes="widgetValue"
                               VerticalAlignment="Center"
                               Text="{Binding AlertText}" />
                </StackPanel>
            </Panel>
        </StackPanel>
    </Border>
</Window>

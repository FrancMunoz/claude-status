<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ClaudeStatus.App.ViewModels"
             xmlns:branding="using:ClaudeStatus.App.Branding"
             xmlns:controls="using:ClaudeStatus.App.Controls"
             x:Class="ClaudeStatus.App.Views.TaskbarWidgetTooltip"
             x:DataType="vm:TaskbarWidgetViewModel">

    <!--
        The hover card for the taskbar widget. It replaced a one-line string that
        wrapped wherever the tooltip felt like it, leaving the last number alone
        on a second line. This is a small table instead: a title, a status line,
        and one row per limit - name, percentage, and when it resets.

        All three limits are listed even when the widget itself hides Fable: the
        hover is where the detail lives, the widget is the glance.
    -->

    <UserControl.Resources>
        <!--
            One Grid per row, but the columns are shared across rows through
            SharedSizeGroup (the scope is the StackPanel below), so the longest
            name and the longest reset text set the width for all three and the
            percentages line up in one column whatever the words around them do.
        -->
        <DataTemplate x:Key="TooltipRow" DataType="vm:UsageBarViewModel">
            <Grid ColumnSpacing="14" Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                    <ColumnDefinition Width="*" MinWidth="56" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="Reset" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Classes="metric"
                           VerticalAlignment="Center"
                           Text="{Binding Label}" />
                <TextBlock Grid.Column="1"
                           Classes="metric"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Classes.exceeded="{Binding IsExceeded}"
                           Classes.unknown="{Binding !IsKnown}"
                           Text="{Binding PercentText}" />
                <TextBlock Grid.Column="2"
                           Classes="caption"
                           TextAlignment="Right"
                           VerticalAlignment="Center"
                           Text="{Binding ResetText}" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel Spacing="8" MinWidth="260">
        <StackPanel Orientation="Horizontal" Spacing="8">
            <!--
                The mark, at the size and spacing DetailsWindow uses: this card
                carries the same heading as the details popup, so the two headers
                should be the same header. It was a 7px dot, which read as a
                bullet rather than as the application.
            -->
            <Path Data="{x:Static branding:AppMark.Geometry}"
                  Width="19"
                  Height="19"
                  Stretch="Uniform"
                  VerticalAlignment="Center"
                  Fill="{DynamicResource Theme.Primary}" />
            <TextBlock Classes="heading"
                       VerticalAlignment="Center"
                       Text="{Binding L[Details_Heading]}" />
        </StackPanel>

        <TextBlock Classes="caption"
                   Classes.exceeded="{Binding IsStale}"
                   Text="{Binding StatusText}" />

        <Border Classes="rule" IsVisible="{Binding HasReading}" />

        <StackPanel IsVisible="{Binding HasReading}" Grid.IsSharedSizeScope="True">
            <ContentControl Content="{Binding TooltipSession}" ContentTemplate="{StaticResource TooltipRow}" />
            <ContentControl Content="{Binding TooltipWeek}" ContentTemplate="{StaticResource TooltipRow}" />
            <ContentControl Content="{Binding TooltipWeekFable}" ContentTemplate="{StaticResource TooltipRow}" />

            <!--
                Credits, in the same three columns: the amount where the
                percentage goes, the state where the reset goes. Only when credits
                are on; the line under it says what is left of the month's cap.
            -->
            <Grid ColumnSpacing="14" Margin="0,3" IsVisible="{Binding Credits.IsShown}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                    <ColumnDefinition Width="*" MinWidth="56" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="Reset" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Classes="metric"
                           VerticalAlignment="Center"
                           Text="{Binding Credits.Label}" />
                <TextBlock Grid.Column="1"
                           Classes="metric"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Classes.exceeded="{Binding Credits.IsExceeded}"
                           Text="{Binding Credits.AmountText}" />
                <TextBlock Grid.Column="2"
                           Classes="caption"
                           TextAlignment="Right"
                           VerticalAlignment="Center"
                           Classes.exceeded="{Binding Credits.IsPastLimits}"
                           Text="{Binding Credits.StateText}" />
            </Grid>
            <TextBlock Classes="caption"
                       TextAlignment="Right"
                       IsVisible="{Binding Credits.IsShown}"
                       Text="{Binding Credits.DetailText}" />
        </StackPanel>

        <!--
            Where the week went. The rows above are text, so the split gets a bar
            of its own here: the weekly reading cut by surface, as on the widget
            and the iCUE panel, with its key underneath.
        -->
        <StackPanel Spacing="6" IsVisible="{Binding TooltipWeek.HasSplit}">
            <Border Classes="rule" />
            <TextBlock Classes="caption" Text="{Binding L[Report_Section_Breakdown]}" />
            <ContentControl Content="{Binding TooltipWeek}">
                <ContentControl.ContentTemplate>
                    <DataTemplate DataType="vm:UsageBarViewModel">
                        <StackPanel Spacing="6">
                            <controls:UsageBar Percent="{Binding Percent}"
                                               Segments="{Binding Segments}"
                                               Classes.exceeded="{Binding IsExceeded}" />
                            <ItemsControl Classes="splitLegend"
                                          Classes.exceeded="{Binding IsExceeded}"
                                          ItemsSource="{Binding SplitKeys}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:UsageShareKeyViewModel">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <Border Classes="splitSwatch" Opacity="{Binding Opacity}" />
                                            <TextBlock Classes="caption" Text="{Binding Label}" />
                                            <TextBlock Classes="caption" FontFeatures="+tnum" Text="{Binding PercentText}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>
        </StackPanel>

        <!--
            The Claude Code sessions. Read-only on purpose: this card never takes
            focus (it is shown while the pointer is elsewhere, and closes when it
            leaves), so a control you could click would not be clickable. Silencing
            a session lives in Config, where there is a window that can be used.
        -->
        <StackPanel IsVisible="{Binding ShowSessions}" Spacing="4">
            <Border Classes="rule" />
            <TextBlock Classes="caption" Text="{Binding L[Sessions_Heading]}" />

            <TextBlock Classes="caption"
                       IsVisible="{Binding !HasSessions}"
                       Text="{Binding L[Sessions_None]}" />

            <ItemsControl ItemsSource="{Binding Sessions}" IsVisible="{Binding HasSessions}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:SessionRowViewModel">
                        <Grid ColumnSpacing="10" Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" MinWidth="52" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Classes="metric"
                                       TextTrimming="CharacterEllipsis"
                                       Text="{Binding Name}" />
                            <TextBlock Grid.Column="1"
                                       Classes="caption"
                                       Classes.unknown="{Binding !IsRunning}"
                                       Text="{Binding StateText}" />
                            <TextBlock Grid.Column="2"
                                       Classes="caption"
                                       TextAlignment="Right"
                                       Text="{Binding DurationText}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- The velocity warning. The card opens by itself to show this. -->
        <Border Classes="warning" MaxWidth="340" IsVisible="{Binding HasNotice}">
            <TextBlock Classes="caption" Text="{Binding NoticeText}" />
        </Border>
    </StackPanel>
</UserControl>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>ClaudeStatus</RootNamespace>
  </PropertyGroup>

  <!--
    Pure .NET. MUST NOT reference Avalonia or any UI framework.
    Contains the domain model, IUsageProvider, IUsageMonitor, ISecretStore,
    IConfigStore and the platform abstractions.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>

  <ItemGroup>
    <!-- Backoff maths is internal but must be asserted directly; driving it only
         through the public loop would need real time to pass. -->
    <InternalsVisibleTo Include="ClaudeStatus.Core.Tests" />
  </ItemGroup>

  <!--
    Every user-facing string in the app lives in Strings.resx and its translations.
    Strings.resx is the neutral set (English) and is the fallback for every key the
    other languages have not translated yet, so a partial translation degrades to
    English line by line rather than to blanks.

    The accessor class is generated by MSBuild rather than by Visual Studio's
    ResXFileCodeGenerator custom tool, so `dotnet build` produces it on a machine
    with no IDE installed - which is what CI has.
  -->
  <ItemGroup>
    <EmbeddedResource Update="Localization\Strings.resx">
      <Generator>MSBuild:Compile</Generator>
      <StronglyTypedFileName>$(IntermediateOutputPath)Strings.Designer.cs</StronglyTypedFileName>
      <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
      <StronglyTypedNamespace>ClaudeStatus.Localization</StronglyTypedNamespace>
      <StronglyTypedClassName>Strings</StronglyTypedClassName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
